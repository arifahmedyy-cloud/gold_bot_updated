# MT5
MT5_LOGIN=0
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo
MT5_LEVERAGE=100

# Risk
RISK_BASE_PCT=1.0
RISK_MAX_PCT=2.0
RISK_DAILY_LOSS_LIMIT_PCT=5.0
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_USE_AUTO_DRAWDOWN=true
RISK_USE_KELLY_SIZING=false
RISK_MAX_OPEN_TRADES=1
RISK_MAX_NET_USD_EXPOSURE=2.0
RISK_MIN_AI_SCORE=55
RISK_USE_TRAILING_STOP=true
RISK_BREAKEVEN_TRIGGER_R=1.0
RISK_BREAKEVEN_BUFFER_PCT=0.05
RISK_TRAILING_TRIGGER_R=1.5
RISK_TRAILING_DISTANCE_R=0.5

# APIs
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini
AI_ASSISTANT_ENABLED=false
ALPHA_VANTAGE_API_KEY=
NEWS_FILTER_ENABLED=false

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFICATIONS_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Broker
BROKER=paper
